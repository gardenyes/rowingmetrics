# Copy this file to keystore.properties in the project root and fill in your values.
# Never commit keystore.properties or your .jks file.

# Path to the keystore file, relative to this project root (e.g. release-key.jks)
storeFile=release-key.jks

storePassword=your_keystore_password
keyAlias=your_key_alias
keyPassword=your_key_password
